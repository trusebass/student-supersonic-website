---
// The mark: a Mach cone. Two wavefronts, the cone tangent to both, and the
// aircraft (orange) at the apex. Same drawing as public/favicon.svg.
interface Props { class?: string }
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <circle cx="11" cy="12" r="4.1" stroke="currentColor" stroke-width="1.3" opacity="0.75" />
  <circle cx="5.5" cy="12" r="6.9" stroke="currentColor" stroke-width="1.3" opacity="0.45" />
  <path d="M19 12 2.2 1.7M19 12 2.2 22.3" stroke="currentColor" stroke-width="1.5" />
  <circle cx="19" cy="12" r="2.4" fill="var(--signal)" />
</svg>
