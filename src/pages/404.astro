---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="section">
    <span class="cross cross-l" aria-hidden="true"></span>
    <span class="cross cross-r" aria-hidden="true"></span>
    <div class="row">
      <p class="section-label label"><span class="idx">404</span><span>Not found</span></p>
      <div class="section-body">
        <p class="statement">This page broke up on the way. <span class="dim">Nothing supersonic here.</span></p>
        <p><a class="btn" href="/"><span class="arrow" aria-hidden="true">←</span> back to the front page</a></p>
      </div>
    </div>
  </section>
</Base>
